# Database
# Postgres connection string — matches the docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linearclone

# Daemon
# Port the daemon HTTP server listens on
DAEMON_PORT=3001
# URL the web server uses to reach the daemon
DAEMON_URL=http://localhost:3001
# URL the daemon uses to reach the web server
WEB_SERVER_URL=http://localhost:3000
