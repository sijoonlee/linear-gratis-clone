# Database
# Postgres connection string — matches the docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linearclone

# Conductor
# Port the conductor HTTP server listens on
CONDUCTOR_PORT=3001
# URL the web server uses to reach the conductor
CONDUCTOR_URL=http://localhost:3001
# URL the conductor uses to reach the web server
WEB_SERVER_URL=http://localhost:3000
